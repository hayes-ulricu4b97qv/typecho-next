# Set default behaviour, in case users don't have core.autocrlf set.
* text=auto

# Keep web assets and Go source files on LF line endings in the working tree.
*.go text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary

